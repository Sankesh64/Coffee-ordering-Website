# ============================================
# COFFEE APP — ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/coffee-app?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Admin (first admin user seed)
ADMIN_EMAIL=admin@coffee.com
ADMIN_PASSWORD=Admin@123456

# Email (optional - for order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
